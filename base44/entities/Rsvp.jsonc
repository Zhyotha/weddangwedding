{
  "name": "Rsvp",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Nama Tamu"
    },
    "attendance": {
      "type": "string",
      "enum": [
        "hadir",
        "tidak_hadir"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "hadir",
      "title": "Kehadiran"
    },
    "guest_count": {
      "type": "number",
      "default": 1,
      "title": "Jumlah Tamu"
    },
    "note": {
      "type": "string",
      "title": "Catatan"
    }
  },
  "required": [
    "guest_name",
    "attendance"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}